{
  "name": "audio-tour-app",
  "version": "1.0.0",
  "description": "Geofenced audio tour app - Supabase backend",
  "private": true,
  "type": "module",
  "directories": {
    "doc": "docs"
  },
  "scripts": {
    "db:start": "supabase start",
    "db:stop": "supabase stop",
    "db:reset": "supabase db reset",
    "db:push": "supabase db push",
    "db:diff": "supabase db diff",
    "typecheck": "tsc --noEmit",
    "types:generate": "supabase gen types typescript --linked > backend/types/supabase.ts",
    "test:db": "node --env-file-if-exists=.env backend/scripts/test-connection.ts",
    "verify:bundle": "node --env-file-if-exists=.env backend/scripts/verify-bundle.ts",
    "ci:db": "supabase db reset && npm run verify:bundle",
    "media:doctor": "node backend/scripts/process-audio.ts doctor",
    "media:process": "node backend/scripts/process-audio.ts",
    "cms:ingest": "node --env-file-if-exists=.env backend/scripts/ingest-audio.ts",
    "sim:walk": "node --env-file-if-exists=.env --import ./mobile/scripts/register-stubs.mjs mobile/scripts/simulate-walk.ts",
    "test:telemetry": "node --env-file-if-exists=.env --import ./mobile/scripts/register-stubs.mjs mobile/scripts/test-telemetry.ts",
    "test:cms": "node backend/scripts/test-cms.ts",
    "test:ui": "node --import ./mobile/scripts/register-stubs.mjs mobile/scripts/test-ui-logic.ts",
    "seed:telaviv": "node --env-file-if-exists=.env backend/scripts/seed-tel-aviv-qa.ts"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "devDependencies": {
    "@types/node": "^26.2.0",
    "supabase": "^2.115.0",
    "typescript": "^7.0.2"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.112.3"
  }
}
