{
  "compilerOptions": {
    "target": "ES2023",
    "lib": ["ES2023"],
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "types": ["node"],
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "verbatimModuleSyntax": true,
    // backend/media imports siblings as "./probe.ts". Node 24 runs TypeScript
    // directly by stripping types, and its resolver takes the specifier
    // literally - so the extension has to be the real one. This option is what
    // lets tsc agree; it is only legal alongside noEmit, which is set below.
    "allowImportingTsExtensions": true,
    "erasableSyntaxOnly": true,
    "noEmit": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true
  },
  "include": ["backend/**/*.ts", "shared/**/*.ts"]
}
