# Copy to mobile/.env and restart the dev server (Expo inlines these at build
# time, so changes need a restart).
#
# EXPO_PUBLIC_* values are embedded in the shipped JS bundle and are PUBLIC.
# Only ever the anon key here - never the service_role key.
EXPO_PUBLIC_SUPABASE_URL=https://fnpqsbbpddibnodkfotm.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=<anon public key from Dashboard > Project Settings > API>
GOOGLE_MAPS_API_KEY=<Android Maps key - put the real value in mobile/.env, NEVER here>

# Optional Google Sign-In (TASK-1102). Public OAuth client IDs, not secrets.
# Leave empty and the Google button stays hidden; Apple and guest still work.
# The iOS one also sets the build's URL scheme, so change it only with a rebuild.
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=
